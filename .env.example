# ──────────────────────────────────────────────────────────────────
# AgriDiffuse v2 — environment configuration
#
# Copy this file to .env (Next.js loads it automatically) and fill in
# whichever integrations you want to run live. Every integration has a
# mock fallback, so the demo runs end-to-end with this file untouched.
# ──────────────────────────────────────────────────────────────────

# ── Neo4j ─────────────────────────────────────────────────────────
# Leave NEO4J_URI blank to run with the in-memory graph store (default
# for dev/demo). Set it to switch to a real Neo4j-backed store — every
# call to the store layer becomes a Cypher round-trip. See the docker-
# compose.yml in the repo root for a one-command local instance.
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# Optional: target a specific database (Neo4j 4.x+ supports multiple).
NEO4J_DATABASE=neo4j

# ── Featherless.ai ────────────────────────────────────────────────
# Leave FEATHERLESS_API_KEY blank to use the local mock narrator.
# When the key is set, every round emits one chat-completion call and
# every "Explain this node" click emits a second.
FEATHERLESS_API_KEY=
# Default is an ungated open model. Llama 3 variants are HF-gated and require
# OAuth via https://featherless.ai/models/<id> before they accept calls.
FEATHERLESS_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# ── Masumi.network ────────────────────────────────────────────────
# MASUMI_MOCK=true returns synthetic agent IDs and tx hashes — recommended
# for live demos where the dev network may be flaky. Setting MASUMI_API_KEY
# and clearing MASUMI_MOCK switches to the live path.
MASUMI_MOCK=true
MASUMI_API_KEY=
MASUMI_API_BASE=https://api.masumi.network/v1
MASUMI_TREASURY_ID=
MASUMI_EXPLORER_BASE=https://preprod.cardanoscan.io/transaction
